<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_purchase_analytics_pdf_report" model="ir.actions.report">
        <field name="name">Purchase Analytics Report</field>
        <field name="model">purchase.analytics.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">purchase_advanced_analytics.purchase_analytics_pdf_template</field>
        <field name="report_file">purchase_advanced_analytics.purchase_analytics_pdf_template</field>
        <field name="print_report_name">'Purchase_Analytics_Report_%s' % (object.report_type or 'summary')</field>
        <field name="binding_model_id" ref="model_purchase_analytics_report_wizard"/>
        <field name="paperformat_id" ref="base.paperformat_a4_landscape"/>
    </record>
</odoo>
