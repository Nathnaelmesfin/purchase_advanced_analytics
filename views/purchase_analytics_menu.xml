<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Purchase Advanced Analytics — Menu Structure
         Placed under the existing Purchase root menu so all items appear
         as a top-level "Analytics" section inside the Purchase app.
    ================================================================ -->

    <!-- ── Top-level "Analytics" menu under Purchase ─────────────────── -->
    <menuitem
        id="menu_purchase_analytics_root"
        name="Analytics"
        parent="purchase.menu_purchase_root"
        sequence="99"
        groups="purchase_advanced_analytics.group_purchase_analytics_user"
    />

    <!-- ── 1. Live Dashboard ─────────────────────────────────────────── -->
    <record id="action_purchase_analytics_live_dashboard" model="ir.actions.client">
        <field name="name">Live Dashboard</field>
        <field name="tag">purchase_analytics_dashboard</field>
        <field name="context">{"mode": "live_dashboard"}</field>
        <field name="target">current</field>
    </record>

    <menuitem
        id="menu_purchase_analytics_live_dashboard"
        name="Live Dashboard"
        parent="menu_purchase_analytics_root"
        action="action_purchase_analytics_live_dashboard"
        sequence="10"
        groups="purchase_advanced_analytics.group_purchase_analytics_user"
    />

